import numpy as np
import matplotlib.pyplot as plt

apple_width = np.random.randint(5, 9, 50)
apple_height = np.random.randint(10, 20, 50)

banana_width = np.random.randint(3, 7, 50)
banana_height = np.random.randint(6, 14, 50)

x_train = []
y_train = []

for i in range(50):
    x_train.append([apple_width[i], apple_height[i]])
    y_train.append(0)

for i in range(50):
    x_train.append([banana_width[i], banana_height[i]])
    y_train.append(1)

new_fruit = [6,14]

plt.scatter(apple_width, apple_height, label="Apple")
plt.scatter(banana_width, banana_height, label="Banana")

plt.scatter(new_fruit[0], new_fruit[1], label="New Fruit")

plt.xlabel("Width")
plt.ylabel("Height")
plt.title("Apple and Banana")
plt.legend()

plt.show()


distances = []

for i in range(len(x_train)):
    x = new_fruit[0] - x_train[i][0]
    y = new_fruit[1] - x_train[i][1]

    distance = np.sqrt(x**2 + y**2)

    distances.append(distance)

print(distances)